<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:models="clr-namespace:Spendly.Models"
             xmlns:helpers="clr-namespace:Spendly.Helpers"
             x:Class="Spendly.Views.ExpenseDetailPage"
             x:DataType="models:Expense"
             Style="{StaticResource Page}"
             Shell.TabBarIsVisible="False">
    <ScrollView>
        <VerticalStackLayout Padding="20" Spacing="18">
            <!-- Amount: typed in code, so it has an x:Name instead of a binding -->
            <Border Style="{StaticResource Card}" Padding="20">
                <VerticalStackLayout Spacing="4">
                    <Label Text="AMOUNT" Style="{StaticResource SectionTitle}" />
                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="6">
                        <Label Text="R" FontFamily="OpenSansSemibold" FontSize="34"
                               TextColor="{StaticResource Brand}" VerticalOptions="Center" />
                        <Entry Grid.Column="1" x:Name="AmountEntry"
                               Placeholder="0.00" Keyboard="Numeric"
                               FontFamily="OpenSansSemibold" FontSize="34"
                               TextColor="{StaticResource Ink}"
                               PlaceholderColor="{StaticResource Muted}" />
                    </Grid>
                </VerticalStackLayout>
            </Border>
            <!-- Title -->
            <VerticalStackLayout Spacing="6">
                <Label Text="What did you buy?" Style="{StaticResource FieldLabel}" />
                <Border Style="{StaticResource Field}">
                    <Entry Text="{Binding Title}" Placeholder="e.g. Lunch at the café"
                           MaxLength="60" TextColor="{StaticResource Ink}"
                           PlaceholderColor="{StaticResource Muted}" />
                </Border>
            </VerticalStackLayout>
            <!-- Category -->
            <VerticalStackLayout Spacing="6">
                <Label Text="Category" Style="{StaticResource FieldLabel}" />
                <Border Style="{StaticResource Field}">
                    <Picker ItemsSource="{x:Static helpers:CategoryHelper.Categories}"
                            SelectedItem="{Binding Category}"
                            Title="Choose a category"
                            TextColor="{StaticResource Ink}" />
                </Border>
            </VerticalStackLayout>
            <!-- Date -->
            <VerticalStackLayout Spacing="6">
                <Label Text="Date" Style="{StaticResource FieldLabel}" />
                <Border Style="{StaticResource Field}">
                    <DatePicker Date="{Binding Date}" Format="d MMM yyyy"
                                TextColor="{StaticResource Ink}" />
                </Border>
            </VerticalStackLayout>
            <!-- Note -->
            <VerticalStackLayout Spacing="6">
                <Label Text="Note (optional)" Style="{StaticResource FieldLabel}" />
                <Border Style="{StaticResource Field}">
                    <Editor Text="{Binding Note}" Placeholder="Anything to remember?"
                            MaxLength="200" HeightRequest="100"
                            TextColor="{StaticResource Ink}"
                            PlaceholderColor="{StaticResource Muted}" />
                </Border>
            </VerticalStackLayout>
            <!-- Buttons -->
            <Button Text="Save expense" Style="{StaticResource PrimaryButton}"
                    Clicked="OnSaveClicked" Margin="0,8,0,0" />
            <Button x:Name="DeleteButton" Text="Delete expense"
                    Style="{StaticResource DangerButton}" Clicked="OnDeleteClicked" />
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>